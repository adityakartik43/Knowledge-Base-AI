# Server
HOST=0.0.0.0
PORT=8001

# PostgreSQL (same database as NestJS backend)
DATABASE_URL=postgresql://user:password@localhost:5432/knowbase

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding dimension — verify with len(embedding) before production use
# text-embedding-3-small defaults to 1536 when dimensions are not specified
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v1

# Chunking (token targets)
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=75

# Retrieval
DEFAULT_TOP_K=5
